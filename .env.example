# ===================================================================
# FRESH TRADE ENGINE - ENVIRONMENT CONFIGURATION
# ===================================================================

# -------------------------------------------------------------------
# Phase 1: IIFL XTS Market Data Feed Credentials
# -------------------------------------------------------------------
# URL provided by your broker for XTS Market Data (e.g. IIFL, Symphony)
# Sandbox URL: https://developers.symphonyfintech.in
# Live Production URL: https://xts.iifl.com/marketdata
XTS_FEED_URL=https://xts.iifl.com/marketdata
XTS_FEED_API_KEY=YOUR_XTS_MARKETDATA_APP_KEY
XTS_FEED_API_SECRET=YOUR_XTS_MARKETDATA_SECRET_KEY

# -------------------------------------------------------------------
# Phase 1: Shoonya (Finvasia) Credentials (Hot Failover)
# -------------------------------------------------------------------
SHOONYA_USER_ID=YOUR_SHOONYA_CLIENT_ID
SHOONYA_PASSWORD=YOUR_SHOONYA_PASSWORD
SHOONYA_TWO_FA=YOUR_TOTP_KEY_OR_PAN
SHOONYA_VENDOR_CODE=YOUR_VENDOR_CODE
SHOONYA_API_SECRET=YOUR_API_KEY

# -------------------------------------------------------------------
# Server Settings
# -------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
